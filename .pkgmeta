package-as: HandyNotes_Homestead

enable-nolib-creation: no

externals:
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0

# CurseForge relation metadata only (a project-page listing, not a packaging instruction).
required-dependencies:
  - handynotes

# Built by the release workflow from CHANGELOG.md. HTML because CurseForge renders
# markdown as plain text; HTML renders on both CurseForge and Wago.
manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

# Keep repo-meta and local-only paths out of the zip. HNH_Dev is untracked but
# listed so a local packager run can't ship it.
ignore:
  - .claude
  - .github
  - .gitignore
  - .luacheckrc
  - .luarc.json
  - .pkgmeta
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - RELEASE_NOTES.html
  - README.md
  - HNH_Dev
  - tests
